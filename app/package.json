{
  "name": "@itonami/hirameki-etz-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "itonami": {
    "id": "network.itonami.hiramekietz",
    "title": "Hirameki (etz)",
    "storageKey": "itonami.hirameki-etz.v1",
    "description": "閃き — 特許の集中と解放を、この端末で観察します。分野ごとの出願人の占有率から、集中度（HHI）・チョークポイントの危険度・満了や開放ライセンスによる解放の進み具合を計算し、迂回・解放・監視のどれに回すかを示します。外部へは何も送信しません。",
    "cljsSources": [
      "../src"
    ],
    "storeId": "network.itonami.hiramekietz"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "tauri": "tauri",
    "build:desktop": "npm run build && tauri build --no-bundle",
    "build:android": "sh scripts/android-apk.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "3.0.0-alpha.6"
  }
}
